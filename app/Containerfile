# Build environment for the app: the Android SDK image from Cirrus Labs plus a
# pinned Flutter release, checked against the sha256 in Google's releases JSON
# (https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json).
FROM ghcr.io/cirruslabs/android-sdk:36

ARG FLUTTER_VERSION=3.47.7
ARG FLUTTER_SHA256=af7455f540df951184c7953fbe3cf884766e7541dacf8571f9f582db03dd6230

RUN curl -fsSLo /tmp/flutter.tar.xz \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
 && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/flutter.tar.xz -C /opt \
 && rm /tmp/flutter.tar.xz

ENV PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH \
    PUB_CACHE=/root/.pub-cache \
    FLUTTER_SUPPRESS_ANALYTICS=true

RUN git config --global --add safe.directory '*' \
 && flutter config --no-analytics --no-cli-animations \
 && dart --disable-analytics \
 && flutter precache --android \
 && (yes | flutter doctor --android-licenses >/dev/null) \
 && flutter --version

# What the Gradle build otherwise downloads on every run of a fresh container:
# Flutter 3.47.7's default NDK (flutter.ndkVersion), the CMake the Flutter
# Gradle plugin asks for, and the platform some plugins compile against.
RUN sdkmanager --install "ndk;28.2.13676358" "cmake;3.22.1" "platforms;android-35" >/dev/null
