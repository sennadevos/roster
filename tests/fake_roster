#!/usr/bin/env python3
"""A stand-in for the roster CLI, for tests/test_hub.py.

It answers from files in $FAKE_ROSTER_DIR: rows.json is what `list --json`
prints, and every call is appended to calls.jsonl (argv and stdin), so a test
can see what the hub ran. `events` prints `change` whenever rows.json changes.
"""

import json
import os
import sys
import time

D = os.environ["FAKE_ROSTER_DIR"]


def fail(reason):
    print("roster: %s" % reason, file=sys.stderr)
    sys.exit(1)


def main():
    argv = sys.argv[1:]
    stdin = sys.stdin.read() if "-" in argv or "--prompt=-" in argv else None
    with open(os.path.join(D, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"argv": argv, "stdin": stdin}) + "\n")
    cmd = argv[0]
    if cmd == "version":
        print("roster 0.2.0 (protocol 1) on hub1")
    elif cmd == "peer":
        print(json.dumps({"machine": "hub1", "version": "0.3.0", "peers": [
            {"machine": "laptop", "ssh": "me@laptop", "reachable": True, "version": "0.3.0", "error": None},
            {"machine": "idle-box", "ssh": "me@idle-box", "reachable": False, "version": None,
             "error": "@idle-box: connection refused"}]}))
    elif cmd == "list":
        with open(os.path.join(D, "rows.json")) as f:
            print(f.read())
    elif cmd == "events":
        print("ready", flush=True)
        path = os.path.join(D, "rows.json")
        last = os.stat(path).st_mtime_ns
        while True:
            time.sleep(0.05)
            m = os.stat(path).st_mtime_ns
            if m != last:
                last = m
                print("change", flush=True)
    elif cmd == "screen":
        print(json.dumps({"agent": argv[1], "status": "blocked", "text": "...",
                          "dialog": {"title": "Do you want to run git push?",
                                     "options": [{"key": "1", "label": "Yes"}, {"key": "2", "label": "No"}]}}))
    elif cmd == "transcript":
        print(json.dumps({"agent": argv[1], "session_id": "s", "next": 3, "messages": [
            {"i": 1, "role": "user", "text": "do it"},
            {"i": 2, "role": "assistant", "text": "All done: tests pass."}]}))
    elif cmd == "prompt":
        if argv[1].startswith("busy@"):
            fail("%s has a dialog open; answer it with keys" % argv[1])
    elif cmd in ("keys", "answer"):
        pass
    elif cmd == "put-file":
        # keep what arrived beside the calls, for the test to compare
        with open(argv[2], "rb") as src, open(os.path.join(D, "put-file.bin"), "wb") as out:
            out.write(src.read())
        name = next(a.split("=", 1)[1] for a in argv if a.startswith("--name="))
        print(json.dumps({"path": "/home/me/.cache/roster/uploads/%s/20261030-1-%s" % (argv[1].split("@")[0], name)}))
    elif cmd == "new":
        if "--brief" in argv:
            print(json.dumps({"agent": "fan-debug@laptop", "name": "fan-debug", "machine": "laptop", "cwd": "~/Desktop/fan-debug",
                              "plan": {"name": "fan-debug", "machine": "laptop", "why": "hardware"}}))
            return
        name = next((a.split("=", 1)[1] for a in argv if a.startswith("--name=")), "ab12cd34")
        on = next(a.split("=", 1)[1] for a in argv if a.startswith("--on="))
        print(json.dumps({"agent": "%s@%s" % (name, on), "name": name, "machine": on,
                          "cwd": "~/src" if on == "hub1" else "/home/me"}))
    elif cmd in ("resume", "kill"):
        if argv[1].startswith("nobody@"):
            fail("no agent named nobody on the roster")
    else:
        fail("unknown command %s" % cmd)


main()
